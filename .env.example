# Discord (obrigatórias)
DISCORD_TOKEN=
# CLIENT_ID: atualmente não utilizado pelo runtime (obsoleto no código atual)
CLIENT_ID=
GUILD_ID=

# Channels
# QUEUE_PANEL_CHANNEL_ID: opcional (painel da fila); sem ele o painel da fila não inicializa
QUEUE_PANEL_CHANNEL_ID=
# QUEUE_CHANNEL_ID: opcional (scheduler altera permissões do canal de fila)
QUEUE_CHANNEL_ID=
# KICK_LINK_CHANNEL_ID: opcional (painel permanente de vínculo Kick)
KICK_LINK_CHANNEL_ID=

# Roles
# SUBSCRIBER_ROLE_ID: obrigatório para /sub-sync (ID do cargo SUB no servidor)
SUBSCRIBER_ROLE_ID=

# Database
# DATABASE_PATH: opcional com padrão ./data/database.sqlite
DATABASE_PATH=./data/database.sqlite

# Environment
# NODE_ENV: opcional com padrão development
NODE_ENV=development
# SHUTDOWN_TIMEOUT_MS: opcional, padrão 10000 (limite interno máximo de 120000)
SHUTDOWN_TIMEOUT_MS=10000

# Scheduler (production)
# Usadas quando NODE_ENV != development.
# Horários interpretados no timezone IANA configurado em QUEUE_TIMEZONE.
QUEUE_OPEN_TIME=19:00
QUEUE_CLOSE_TIME=08:00
QUEUE_TIMEZONE=America/Sao_Paulo

# Scheduler (development only)
QUEUE_TEST_INTERVAL_MINUTES=5

# SUB Role Reconciliation Scheduler
# SUB_ROLE_RECONCILIATION_ENABLED: opcional, padrão true
SUB_ROLE_RECONCILIATION_ENABLED=false
# SUB_ROLE_RECONCILIATION_INTERVAL_MINUTES: opcional, padrão 15
SUB_ROLE_RECONCILIATION_INTERVAL_MINUTES=15
# SUB_ROLE_RECONCILIATION_STARTUP_DELAY_SECONDS: opcional, padrão 30
SUB_ROLE_RECONCILIATION_STARTUP_DELAY_SECONDS=30
# SUB_ROLE_RECONCILIATION_DISCOVERY_TIMEOUT_MS: opcional, padrão 20000
SUB_ROLE_RECONCILIATION_DISCOVERY_TIMEOUT_MS=20000
# SUB_ROLE_RECONCILIATION_USER_SYNC_TIMEOUT_MS: opcional, padrão 12000
SUB_ROLE_RECONCILIATION_USER_SYNC_TIMEOUT_MS=12000

# Kick Integration
# KICK_CLIENT_ID/KICK_CLIENT_SECRET: opcionais, porém obrigatórias para habilitar OAuth e sync de eventos
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# KICK_HOST: opcional com padrão 127.0.0.1 (Railway: use 0.0.0.0)
KICK_HOST=127.0.0.1
# PORT: reservada para plataforma (precedência sobre KICK_PORT quando definida)
# PORT=
# KICK_REDIRECT_URI: opcional com padrão http://localhost:3000/kick/callback
KICK_REDIRECT_URI=http://localhost:3000/kick/callback
# KICK_OAUTH_SCOPES: atualmente não utilizado pelo runtime (obsoleto no código atual)
KICK_OAUTH_SCOPES=user:read events:subscribe
# KICK_PORT: opcional com padrão 3000 (usada quando PORT não existir)
KICK_PORT=3000
# KICK_BROADCASTER_USER_ID: obrigatório para webhooks/subscriptions Kick
KICK_BROADCASTER_USER_ID=
# KICK_HTTP_MAX_BODY_BYTES: opcional, padrão 1048576 (1 MiB)
KICK_HTTP_MAX_BODY_BYTES=1048576
# KICK_HTTP_BODY_TIMEOUT_MS: opcional, padrão 10000 (10 segundos)
KICK_HTTP_BODY_TIMEOUT_MS=10000
# KICK_HTTP_MAX_URL_LENGTH: opcional, padrão 8192 (8 KiB)
KICK_HTTP_MAX_URL_LENGTH=8192

# SQLite Backup
# SQLITE_BACKUP_ENABLED: opcional, padrão true
SQLITE_BACKUP_ENABLED=true
# SQLITE_BACKUP_DIRECTORY: opcional, padrão ./backups
SQLITE_BACKUP_DIRECTORY=./backups
# SQLITE_BACKUP_TIME: opcional, padrão 08:15 (HH:MM)
SQLITE_BACKUP_TIME=08:15
# SQLITE_BACKUP_TIMEZONE: opcional, padrão America/Sao_Paulo (IANA)
SQLITE_BACKUP_TIMEZONE=America/Sao_Paulo
# SQLITE_BACKUP_RETENTION_DAYS: opcional, padrão 7
SQLITE_BACKUP_RETENTION_DAYS=7
# SQLITE_BACKUP_STARTUP_DELAY_SECONDS: opcional, padrão 60
SQLITE_BACKUP_STARTUP_DELAY_SECONDS=60
