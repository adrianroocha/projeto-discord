{
  "name": "projeto-discord",
  "version": "1.0.0",
  "description": "Estrutura inicial de bot Discord.js v14 com SQLite e dotenv",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --exec \"node src/index.js\"",
    "lint": "eslint src tests --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "sqlite",
    "dotenv"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.13.0",
    "dotenv": "^16.0.0",
    "better-sqlite3": "^8.4.0"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "better-sqlite3@8.7.0": true
  }
}
